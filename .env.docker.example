# Copy this file to .env before running `docker compose up`.
# Generate secrets with: openssl rand -base64 32

# Public URL of the app. Also used for GitHub App callback and webhook URLs.
BASE_URL=http://localhost:3000

BETTER_AUTH_SECRET=replace-with-a-random-secret
CRYPTO_KEY=replace-with-a-random-secret

# Optional: comma-separated allowlist for the admin panel.
# ADMIN_EMAILS=admin@example.com

# GitHub App settings. `npm run setup:github-app -- --base-url http://localhost:3000 --env .env`
# can create the app and fill these in.
GITHUB_APP_ID=
GITHUB_APP_NAME=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Optional email settings.
# EMAIL_PROVIDER=resend
# EMAIL_FROM="Pages CMS <no-reply@example.com>"
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# PostgreSQL settings used by compose.yml.
# Keep POSTGRES_PASSWORD URL-safe (for example: openssl rand -hex 32) because
# it is embedded in the app's DATABASE_URL.
POSTGRES_DB=pagescms
POSTGRES_USER=pagescms
POSTGRES_PASSWORD=replace-with-a-random-password

# Host port for the app.
APP_PORT=3000
